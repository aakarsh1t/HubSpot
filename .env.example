# ---------------------------------------------------------------------------
# HubSpot MCP Server — example configuration
#
# Copy to `.env` for local development:   cp .env.example .env
#
# In Azure App Service do NOT deploy a .env file. Set these as App Settings
# (Configuration → Application settings) so they arrive as real environment
# variables. The loader uses `override: false`, so platform settings always win
# over anything in a stray .env.
#
# Every variable is validated at startup by src/config/env.schema.ts. An
# invalid value stops the process with a message naming the variable — the
# server never boots into a half-configured state.
# ---------------------------------------------------------------------------

# --------------------------------- runtime ---------------------------------
NODE_ENV=development
SERVICE_NAME=hubspot-mcp-server
SERVICE_VERSION=0.1.0

# ----------------------------------- http ----------------------------------
# Azure App Service injects PORT itself; leave it unset there.
PORT=8080
# Must stay 0.0.0.0 on App Service, or the platform health probe cannot reach
# the container.
HOST=0.0.0.0
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_SHUTDOWN_TIMEOUT_MS=15000
# Required behind the App Service reverse proxy for correct client IPs.
HTTP_TRUST_PROXY=true

# --------------------------------- logging ---------------------------------
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Human-readable output for local dev only. Leave false in Azure so logs stay
# newline-delimited JSON for Log Analytics / Application Insights.
LOG_PRETTY=true

# ----------------------------------- mcp -----------------------------------
MCP_SERVER_NAME=hubspot-mcp-server
MCP_SERVER_VERSION=0.1.0
# The URL you give Copilot Studio is https://<your-app>.azurewebsites.net/mcp
MCP_ENDPOINT_PATH=/mcp

# stateless (default) | stateful
#   stateless — no session state; any instance can serve any request. Required
#               for safe scale-out on App Service without ARR affinity.
#   stateful  — sessions held in memory; needs session affinity enabled.
MCP_SESSION_MODE=stateless

# true returns a single JSON body per POST instead of opening an SSE stream.
# Power Platform / Copilot Studio connectors proxy plain JSON far more
# reliably than long-lived streams, so keep this true for Copilot Studio.
MCP_ENABLE_JSON_RESPONSE=true

# Only used when MCP_SESSION_MODE=stateful.
MCP_SESSION_TTL_MS=1800000
MCP_MAX_SESSIONS=1000

# --------------------------------- security --------------------------------
# Inbound authentication for THIS server (what Copilot Studio presents to us).
# Setting this to false is refused outright when NODE_ENV=production.
MCP_AUTH_ENABLED=true
# Minimum 32 characters. Generate with:  openssl rand -hex 32
MCP_API_KEY=a9febeeaa19f715a9564f3d1672a527b09eb3904f330709a054c76dbd218ea67
# Header name to configure in the Copilot Studio MCP wizard (API key → Header).
MCP_API_KEY_HEADER=x-api-key

# --------------------------------- hubspot ---------------------------------
# private_app | oauth
HUBSPOT_AUTH_MODE=private_app
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_REQUEST_TIMEOUT_MS=30000

# --- Required when HUBSPOT_AUTH_MODE=private_app ---
# HubSpot → Settings → Integrations → Private Apps → your app → Auth tab.
# Grant at least the `oauth` scope so the connection test can read account details.
HUBSPOT_PRIVATE_APP_TOKEN=replace-with-hubspot-private-app-token

# --- Required when HUBSPOT_AUTH_MODE=oauth ---
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REFRESH_TOKEN=
# HUBSPOT_REDIRECT_URI=https://your-app.azurewebsites.net/oauth/callback
# Space- or comma-separated.
# HUBSPOT_SCOPES=oauth crm.objects.contacts.read
# Renew this many seconds before expiry so no token dies mid-request.
# HUBSPOT_TOKEN_REFRESH_MARGIN_SECONDS=300

# ---------------------------------- retry ----------------------------------
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=250
RETRY_MAX_DELAY_MS=8000
RETRY_BACKOFF_FACTOR=2
# Full jitter — stops every instance retrying in lockstep after an outage.
RETRY_JITTER=true

# -------------------------------- rate limits ------------------------------
# Inbound: protects this server from its callers.
HTTP_RATE_LIMIT_ENABLED=true
HTTP_RATE_LIMIT_MAX=300
HTTP_RATE_LIMIT_WINDOW_MS=60000

# Outbound: protects the HubSpot API quota. HubSpot's documented baseline for
# private apps is 110 requests / 10s; the default leaves headroom for other
# integrations sharing the same portal.
HUBSPOT_RATE_LIMIT_ENABLED=true
HUBSPOT_RATE_LIMIT_MAX_REQUESTS=100
HUBSPOT_RATE_LIMIT_WINDOW_MS=10000
# How long a call may queue for a token before failing fast with 429.
HUBSPOT_RATE_LIMIT_MAX_QUEUE_MS=10000

# ------------------------------ circuit breaker ----------------------------
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_OPEN_STATE_MS=30000
